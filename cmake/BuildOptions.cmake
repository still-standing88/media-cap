option(BUILD_SHARED_LIBS "Build a shared MediaCap library; OFF builds static" ON)
option(MEDIACAP_BUILD_CLI "Build the MediaCap command-line executable" OFF)
option(MEDIACAP_BUILD_GUI "Build the AudioPix desktop application" OFF)
option(MEDIACAP_FETCH_SLINT "Fetch Slint when AudioPix is enabled and no SDK is installed" ON)
option(MEDIACAP_BUILD_EXAMPLES "Build the standalone API examples" ON)
option(MEDIACAP_BUILD_TESTS "Build unit and integration tests" OFF)
option(MEDIACAP_BUILD_PYTHON "Build the MediaCap CPython extension" OFF)
if(MEDIACAP_BUILD_PYTHON AND NOT BUILD_SHARED_LIBS)
    set(CMAKE_POSITION_INDEPENDENT_CODE ON)
endif()
option(MEDIACAP_USE_VCPKG "Use vcpkg to find FFmpeg" ON)

if(NOT CMAKE_CONFIGURATION_TYPES AND NOT CMAKE_BUILD_TYPE)
    set(CMAKE_BUILD_TYPE Release CACHE STRING "Build configuration" FORCE)
endif()
if(NOT CMAKE_CONFIGURATION_TYPES)
    set_property(CACHE CMAKE_BUILD_TYPE PROPERTY STRINGS Debug Release RelWithDebInfo MinSizeRel)
endif()

if(APPLE)
    enable_language(OBJC OBJCXX)
    set(CMAKE_OBJCXX_STANDARD 17)
    set(CMAKE_OBJCXX_STANDARD_REQUIRED ON)
endif()
if(WIN32)
    set(CMAKE_RUNTIME_OUTPUT_DIRECTORY "${PROJECT_BINARY_DIR}/bin")
endif()
