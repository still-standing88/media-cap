option(MEDIACAP_FLEXAUDIO "Build vendored Rust audio capture" ON)
set(MEDIACAP_FLEXAUDIO_CARGO "cargo" CACHE STRING "Cargo executable")
set(MEDIACAP_FLEXAUDIO_TARGET "" CACHE STRING "Rust target triple (required for cross builds)")
option(MEDIACAP_FLEXAUDIO_OFFLINE "Require cached Cargo dependencies" OFF)
if(NOT MEDIACAP_FLEXAUDIO)
    target_compile_definitions(MediaCap PRIVATE MEDIACAP_HAS_FLEXAUDIO=0)
    return()
endif()
unset(FLEXAUDIO_CARGO CACHE)
find_program(FLEXAUDIO_CARGO NAMES "${MEDIACAP_FLEXAUDIO_CARGO}")
if(NOT FLEXAUDIO_CARGO)
    message(FATAL_ERROR "Cargo not found; set MEDIACAP_FLEXAUDIO_CARGO or disable MEDIACAP_FLEXAUDIO")
endif()
find_package(Python3 REQUIRED COMPONENTS Interpreter)
if(CMAKE_CROSSCOMPILING AND NOT MEDIACAP_FLEXAUDIO_TARGET)
    message(FATAL_ERROR "Set MEDIACAP_FLEXAUDIO_TARGET for cross compilation")
endif()
set(flex_manifest "${PROJECT_SOURCE_DIR}/src/integrations/flexaudio_bridge/Cargo.toml")
set(flex_script "${PROJECT_SOURCE_DIR}/scripts/build_flexaudio.py")
execute_process(COMMAND "${Python3_EXECUTABLE}" "${flex_script}" --manifest "${flex_manifest}" --sources
    OUTPUT_VARIABLE flex_sources OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE flex_sources_status)
if(NOT flex_sources_status EQUAL 0)
    message(FATAL_ERROR "Could not enumerate flexaudio source dependencies")
endif()
string(REPLACE "\n" ";" flex_sources "${flex_sources}")
if(WIN32)
    set(flex_name mediacap_flexaudio.lib)
    set(flex_flags --crt-static)
    set(flex_native kernel32 ntdll userenv ws2_32 dbghelp)
else()
    set(flex_name libmediacap_flexaudio.a)
    set(flex_flags)
    if(APPLE)
        set(flex_native "-framework CoreAudio" "-framework AudioToolbox" "-framework CoreFoundation"
            "-framework Foundation" "-framework AVFoundation" "-framework Security" objc iconv)
    else()
        find_package(PkgConfig REQUIRED)
        pkg_check_modules(FLEX_ALSA REQUIRED IMPORTED_TARGET alsa)
        pkg_check_modules(FLEX_PIPEWIRE REQUIRED IMPORTED_TARGET libpipewire-0.3)
        set(flex_native PkgConfig::FLEX_ALSA PkgConfig::FLEX_PIPEWIRE ${CMAKE_DL_LIBS} m rt util)
    endif()
endif()
if(MEDIACAP_FLEXAUDIO_OFFLINE)
    list(APPEND flex_flags --offline)
endif()
set(flex_library "${CMAKE_CURRENT_BINARY_DIR}/${flex_name}")
add_custom_command(OUTPUT "${flex_library}"
    COMMAND "${Python3_EXECUTABLE}" "${flex_script}" --cargo "${FLEXAUDIO_CARGO}"
        --manifest "${flex_manifest}" --target-dir "${CMAKE_CURRENT_BINARY_DIR}/flexaudio-target"
        --target "${MEDIACAP_FLEXAUDIO_TARGET}" --output "${flex_library}" ${flex_flags}
    DEPENDS ${flex_sources} "${flex_script}" VERBATIM)
add_custom_target(mediacap_flexaudio_build DEPENDS "${flex_library}")
add_library(mediacap_flexaudio STATIC IMPORTED GLOBAL)
set_target_properties(mediacap_flexaudio PROPERTIES IMPORTED_LOCATION "${flex_library}")
add_dependencies(mediacap_flexaudio mediacap_flexaudio_build)
target_link_libraries(MediaCap PRIVATE $<BUILD_INTERFACE:mediacap_flexaudio>
    $<INSTALL_INTERFACE:${CMAKE_INSTALL_LIBDIR}/${flex_name}> ${flex_native})
target_compile_definitions(MediaCap PRIVATE MEDIACAP_HAS_FLEXAUDIO=1)
if(NOT BUILD_SHARED_LIBS)
    install(FILES "${flex_library}" DESTINATION "${CMAKE_INSTALL_LIBDIR}")
endif()
if(MSVC)
    # Rust's prebuilt std names the release static CRT. Resolve its C imports
    # against the selected debug static CRT in /MTd builds; never load both.
    if(BUILD_SHARED_LIBS)
        target_link_options(MediaCap PRIVATE $<$<CONFIG:Debug>:/NODEFAULTLIB:libcmt>)
    else()
        target_link_options(MediaCap PUBLIC $<$<CONFIG:Debug>:/NODEFAULTLIB:libcmt>)
    endif()
endif()
install(FILES "${PROJECT_SOURCE_DIR}/src/third_party/flexaudio/LICENSE"
    "${PROJECT_SOURCE_DIR}/src/third_party/flexaudio/THIRD_PARTY_NOTICES.md"
    DESTINATION "${CMAKE_INSTALL_DATADIR}/licenses/MediaCap/flexaudio")
