set(MEDIACAP_VCPKG_ROOT "$ENV{VCPKG_ROOT}" CACHE PATH "vcpkg checkout")
if(MEDIACAP_USE_VCPKG)
    if(CMAKE_TOOLCHAIN_FILE AND NOT MEDIACAP_VCPKG_ROOT)
        get_filename_component(vcpkg_toolchain_dir "${CMAKE_TOOLCHAIN_FILE}" DIRECTORY)
        get_filename_component(MEDIACAP_VCPKG_ROOT "${vcpkg_toolchain_dir}/../.." ABSOLUTE)
    endif()
    if(NOT VCPKG_TARGET_TRIPLET)
        if(WIN32)
            if(CMAKE_SYSTEM_PROCESSOR MATCHES "ARM|aarch64")
                set(VCPKG_TARGET_TRIPLET arm64-windows-static)
            elseif(CMAKE_SIZEOF_VOID_P EQUAL 8)
                set(VCPKG_TARGET_TRIPLET x64-windows-static)
            else()
                set(VCPKG_TARGET_TRIPLET x86-windows-static)
            endif()
        elseif(APPLE)
            if(CMAKE_SYSTEM_PROCESSOR MATCHES "arm64|aarch64")
                set(VCPKG_TARGET_TRIPLET arm64-osx)
            else()
                set(VCPKG_TARGET_TRIPLET x64-osx)
            endif()
        elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux")
            if(CMAKE_SYSTEM_PROCESSOR MATCHES "arm64|aarch64")
                set(VCPKG_TARGET_TRIPLET arm64-linux)
            elseif(CMAKE_SIZEOF_VOID_P EQUAL 8)
                set(VCPKG_TARGET_TRIPLET x64-linux)
            else()
                set(VCPKG_TARGET_TRIPLET x86-linux)
            endif()
        else()
            message(FATAL_ERROR "Set VCPKG_TARGET_TRIPLET or specify FFmpeg directories")
        endif()
    endif()
    if(WIN32 AND NOT VCPKG_TARGET_TRIPLET MATCHES "-windows-static$")
        message(FATAL_ERROR "MediaCap requires a static CRT triplet (*-windows-static)")
    endif()
    set(VCPKG_INSTALLED_DIR "${MEDIACAP_VCPKG_ROOT}/installed/${VCPKG_TARGET_TRIPLET}")
    set(FFMPEG_INCLUDE_DIRS "${VCPKG_INSTALLED_DIR}/include")
    set(ffmpeg_release_dir "${VCPKG_INSTALLED_DIR}/lib")
    set(ffmpeg_debug_dir "${VCPKG_INSTALLED_DIR}/debug/lib")
else()
    set(MEDIACAP_FFMPEG_INCLUDE_DIR "" CACHE PATH "FFmpeg headers")
    set(MEDIACAP_FFMPEG_LIBRARY_DIR "" CACHE PATH "FFmpeg static libraries")
    set(MEDIACAP_FFMPEG_DEBUG_LIBRARY_DIR "${MEDIACAP_FFMPEG_LIBRARY_DIR}" CACHE PATH "FFmpeg debug static libraries")
    set(FFMPEG_INCLUDE_DIRS "${MEDIACAP_FFMPEG_INCLUDE_DIR}")
    set(ffmpeg_release_dir "${MEDIACAP_FFMPEG_LIBRARY_DIR}")
    set(ffmpeg_debug_dir "${MEDIACAP_FFMPEG_DEBUG_LIBRARY_DIR}")
endif()
set(FFMPEG_LIBS)
if(NOT WIN32 AND NOT EXISTS "${ffmpeg_debug_dir}")
    set(ffmpeg_debug_dir "${ffmpeg_release_dir}")
endif()
set(FFMPEG_RELEASE_FILES)
set(FFMPEG_DEBUG_FILES)
set(ffmpeg_names avformat avcodec swscale swresample avutil aom dav1d openh264 opus vorbisenc vorbis ogg vpx mp3lame)
if(WIN32)
    list(APPEND ffmpeg_names mpghip)
endif()
foreach(name IN LISTS ffmpeg_names)
    unset(lib_release CACHE)
    unset(lib_debug CACHE)
    find_library(lib_release NAMES ${name} lib${name} ${name}-static lib${name}-static PATHS "${ffmpeg_release_dir}" NO_DEFAULT_PATH REQUIRED)
    find_library(lib_debug NAMES ${name} lib${name} ${name}-static lib${name}-static PATHS "${ffmpeg_debug_dir}" NO_DEFAULT_PATH REQUIRED)
    list(APPEND FFMPEG_RELEASE_FILES "${lib_release}")
    list(APPEND FFMPEG_DEBUG_FILES "${lib_debug}")
    list(APPEND FFMPEG_LIBS "$<$<CONFIG:Debug>:${lib_debug}>" "$<$<NOT:$<CONFIG:Debug>>:${lib_release}>")
endforeach()
set(ffmpeg_os_libs)
if(WIN32)
    set(ffmpeg_os_libs bcrypt mfuuid strmiids ole32 oleaut32 uuid user32 advapi32 ws2_32 secur32 mfplat mf)
elseif(APPLE)
    set(ffmpeg_os_libs "-framework AppKit" "-framework AudioToolbox" "-framework AVFoundation"
        "-framework CoreFoundation" "-framework CoreImage" "-framework CoreMedia"
        "-framework CoreVideo" "-framework VideoToolbox" "-framework Security" "-framework CoreServices" iconv)
elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux")
    set(ffmpeg_os_libs Threads::Threads ${CMAKE_DL_LIBS} m)
endif()
list(APPEND FFMPEG_LIBS ${ffmpeg_os_libs})
if(CMAKE_CROSSCOMPILING AND NOT CMAKE_CROSSCOMPILING_EMULATOR)
    message(FATAL_ERROR "Set CMAKE_CROSSCOMPILING_EMULATOR to validate FFmpeg license/codec policy")
endif()
if(CMAKE_BUILD_TYPE STREQUAL "Debug")
    set(probe_libs ${FFMPEG_DEBUG_FILES})
else()
    set(probe_libs ${FFMPEG_RELEASE_FILES})
endif()
if(CMAKE_BUILD_TYPE STREQUAL "Debug")
    set(CMAKE_TRY_COMPILE_CONFIGURATION Debug)
else()
    set(CMAKE_TRY_COMPILE_CONFIGURATION Release)
endif()
try_run(policy_status policy_compiled "${PROJECT_BINARY_DIR}/ffmpeg-policy"
    "${PROJECT_SOURCE_DIR}/scripts/ffmpeg_check.cpp"
    CMAKE_FLAGS "-DINCLUDE_DIRECTORIES:STRING=${FFMPEG_INCLUDE_DIRS}" "-DCMAKE_CXX_STANDARD=17"
    LINK_LIBRARIES ${probe_libs} ${ffmpeg_os_libs}
    COMPILE_OUTPUT_VARIABLE policy_build RUN_OUTPUT_VARIABLE policy_output)
if(NOT policy_compiled OR NOT policy_status EQUAL 0)
    message(FATAL_ERROR "FFmpeg policy check failed:\n${policy_build}\n${policy_output}")
endif()
message(STATUS "${policy_output}")
